DDL PRACTICE QUESTIONS
======================

-- BASIC: DATABASE & TABLE

--1. Create a database named school_db.

CREATE DATABASE school_db;

--2. Create a database named inventory_db only if it does not already exist.

CREATE DATABASE IF NOT EXISTS inventory_db;

--3. Select school_db as the current database.

USE school_db;

--4. Create a students table with:
   StudentID, FirstName, LastName, Age, Email.

CREATE TABLE students(
StudentID INT ,
FirstName VARCHAR(20),
LastName VARCHAR(20),
Age INT,
Email VARCHAR(30)
);

-- 5. Create an employees table using appropriate data types for:
   EmployeeID, EmployeeName, Salary, JoiningDate, IsActive.

CREATE TABLE employees(
EmployeeID INT ,
EmployeeName VARCHAR(30),
Salary DECIMAL(10,2),
JoiningDate DATE,
IsActive BOOLEAN
);

-- PRIMARY KEY & AUTO_INCREMENT

-- 6. Alter  students table set StudentID is the PRIMARY KEY.

ALTER TABLE students
MODIFY COLUMN StudentID INT PRIMARY KEY;

-- 7. Alter employees table set EmployeeID is
   the PRIMARY KEY and AUTO_INCREMENT.

ALTER TABLE employees
MODIFY COLUMN EmployeeID INT PRIMARY KEY AUTO_INCREMENT;

-- 8. Alter the existing employees table to remove AUTO_INCREMENT from the EmployeeID column while keeping it as the PRIMARY KEY.

ALTER TABLE employees
MODIFY COLUMN EmployeeID INT PRIMARY KEY ;

-- 9. Remove the PRIMARY KEY from an existing table.

ALTER TABLE employees 
DROP PRIMARY KEY;


-- NOT NULL & UNIQUE

-- 10. Alter employees table EmployeeName
    cannot contain NULL values.

ALTER TABLE employees 
MODIFY COLUMN EmployeeName VARCHAR(30) NOT NULL;

-- 11. Alter table employees set Email to be UNIQUE.

ALTER TABLE employees 
ADD CONSTRAINT email_employees UNIQUE(Email);

-- 12. Add a NOT NULL constraint to an existing column.

ALTER TABLE students
MODIFY COLUMN StudentID INT NOT NULL;

-- 13. Add a UNIQUE constraint to an existing column.

ALTER TABLE students
ADD CONSTRAINT email_students UNIQUE(Email);

-- 14. Remove a UNIQUE constraint from an existing table.

ALTER TABLE students
DROP INDEX email_students;


-- DEFAULT

-- 15. ALTER employees table SET IsActive
   a DEFAULT value of TRUE.

ALTER TABLE employees
MODIFY COLUMN IsActive BOOLEAN DEFAULT TRUE;

-- 16. Create an orders table where OrderStatus
    has a DEFAULT value of 'Pending'.

CREATE TABLE IF NOT EXISTS orders (
OrderStatus VARCHAR(16) DEFAULT 'Pending'
);

-- 17. Add a DEFAULT value to an existing column.

ALTER TABLE employees
ALTER COLUMN IsActive SET DEFAULT TRUE;


-- CHECK

-- 18. Create an employees1 table where Salary
    must be greater than 0.

CREATE TABLE employees1(
Salary DECIMAL(10,2) CHECK(Salary>0)
);

-- 19. Create a products table where Price
    must be greater than or equal to 0.

CREATE TABLE products(
Price DECIMAL(10,2) CHECK(Price>=0)
);

-- 20. Add a CHECK constraint to an existing table.

ALTER TABLE employees
ADD CONSTRAINT check_salary CHECK(Salary>0) ;

-- FOREIGN KEY

-- 21. Create a departments table where DepartmentID
    is the PRIMARY KEY.

CREATE TABLE IF NOT EXISTS departments(
DepartmentID INT PRIMARY KEY
);

-- 22. Create an employees table where DepartmentID
    is a FOREIGN KEY referencing departments.

CREATE TABLE IF NOT EXISTS employees(
DepartmentID VARCHAR(10),
FOREIGN KEY(DepartmentID) REFERENCES departments(DepartmentID)
);

-- 23. Add a FOREIGN KEY to an existing employees table.

ALTER TABLE employees
ADD CONSTRAINT foreign_employees
ADD FOREIGN KEY(EmployeeID)
REFERENCES departments(EmployeeID);

-- 24. Remove a FOREIGN KEY constraint from an existing table.

ALTER TABLE employees
DROP FOREIGN KEY foreign_employees;

-- ALTER TABLE

-- 25. Add a Phone column to the employees table.

ALTER TABLE employees
ADD COLUMN Phone VARCHAR(20) ;

